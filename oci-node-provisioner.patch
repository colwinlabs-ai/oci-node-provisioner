+# Copy this file to `.env` for LOCAL testing only.
+# In GitHub Actions these are injected as repository Secrets instead —
+# never commit a real .env file (it's already covered by .gitignore).
+
+OCI_USER_ID=ocid1.user.oc1..xxxxxxxx
+OCI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
+OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
+OCI_TENANCY_ID=ocid1.tenancy.oc1..xxxxxxxx
+OCI_REGION=us-phoenix-1
+OCI_SUBNET_ID=ocid1.subnet.oc1.phx.xxxxxxxx
+OCI_IMAGE_ID=ocid1.image.oc1.phx.aaaaaaaagrsiqy75p2vblxtrqn7ttjyafrzronnu7sfaibu6pfz6y2beeb2q
+OCI_PUBLIC_SSH_KEY="ssh-ed25519 AAAA... your-key-comment"
+
+# Optional tuning (defaults shown) — keep OCI_MAX_ATTEMPTS * OCI_RETRY_DELAY_SECONDS
+# comfortably under the cron interval in .github/workflows/oci_spawn.yml (5 min)
+# so scheduled runs never overlap.
+OCI_MAX_ATTEMPTS=4
+OCI_RETRY_DELAY_SECONDS=60
diff --git a/.github/workflows/oci_spawn.yml b/.github/workflows/oci_spawn.yml
index e035dea..5f81944 100644
--- a/.github/workflows/oci_spawn.yml
+++ b/.github/workflows/oci_spawn.yml
@@ -4,9 +4,23 @@ on:
     - cron: '*/5 * * * *'  # Runs every 5 minutes automatically
   workflow_dispatch:       # Allows manual execution triggers
 
+# CRITICAL: without this, a run that takes longer than 5 minutes overlaps
+# with the next scheduled trigger. Multiple concurrent runs hammer the OCI
+# API in parallel and, in the rare case two succeed near-simultaneously,
+# can launch more than one A1.Flex instance and blow past the Always Free
+# quota. `cancel-in-progress: false` means new triggers QUEUE instead of
+# running in parallel — at most one bot.py process runs at a time.
+concurrency:
+  group: oci-provisioner
+  cancel-in-progress: false
+
+permissions:
+  contents: read   # this workflow only reads the repo; no write access needed
+
 jobs:
   attempt-build:
     runs-on: ubuntu-latest
+    timeout-minutes: 10   # safety net in case the OCI SDK ever hangs
     steps:
       - name: Check out repository code
         uses: actions/checkout@v4
